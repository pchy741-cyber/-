# ========================================
# 로컬 Paper 모드 설정 (노트북용)
# 이 파일을 .env로 복사: cp .env.local.example .env
# ========================================

NODE_ENV=development
TRADING_MODE=paper
PAPER_ONLY=true

# ── Claude CLI (Max 구독 토큰 활용) ──
# true → ANTHROPIC_API_KEY 대신 claude -p CLI 사용
# 사전 필요: npm install -g @anthropic-ai/claude-code && claude login
USE_CLAUDE_CLI=true

# ── KIS 모의투자 ──
KIS_APP_KEY=여기에_모의투자_앱키
KIS_APP_SECRET=여기에_모의투자_시크릿
KIS_ACCOUNT_NO=12345678-01
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# ── DB (Supabase - Cloud Run과 동일 DB 공유) ──
DATABASE_URL=postgresql://postgres.xxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── AI (Gemini 무료 + Claude CLI) ──
GEMINI_API_KEY=여기에_gemini_키
# ANTHROPIC_API_KEY= ← USE_CLAUDE_CLI=true면 불필요
# OPENAI_API_KEY= ← 선택사항

# ── 알림 ──
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇토큰
TELEGRAM_CHAT_ID=여기에_채팅ID

# ── 리스크 (Paper 연습용 - 느슨하게) ──
RISK_MAX_DAILY_DRAWDOWN_KRW=5000000
RISK_MAX_POSITION_KRW=3000000
RISK_MAX_TOTAL_INVESTED_PCT=95
